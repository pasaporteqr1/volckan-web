rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para determinar si el usuario es administrador autenticado
    function isAdmin() {
      return request.auth != null;
    }

    // 1. Configuración del portal, catálogos y formularios
    // Lectura pública para la tienda y formularios, escritura protegida para administradores
    match /config/{configDoc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Colección de Solicitudes y Emisión de Carnets
    match /carnet_submissions/{submissionId} {
      // Creación pública desde el formulario con validación estricta de estructura
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.fullName.size() >= 2
                    && request.resource.data.fullName.size() <= 120
                    && request.resource.data.idNumber is string
                    && request.resource.data.idNumber.size() >= 4
                    && request.resource.data.idNumber.size() <= 60
                    && request.resource.data.status in ['pendiente', 'aprobado', 'impreso'];

      // Lectura individual (get): pública para verificar credencial en tiempo real por ID único
      allow get: if true;

      // Listado masivo y consultas (list): RESTRINGIDO EXCLUSIVAMENTE A ADMINISTRADORES
      // Evita enumeraciones masivas, scraping de identidades, DPIs o teléfonos
      allow list: if isAdmin();

      // Modificación de estado y eliminación: solo administradores
      allow update, delete: if isAdmin();
    }

    // 3. Documento legado de respaldo para sincronización
    match /data/carnet_submissions {
      allow read, write: if isAdmin();
    }

    // 4. Catálogos y colecciones de la tienda
    match /mercado_products/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mercado_collections/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mercado_categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Colección de Pedidos y Cotizaciones Comerciales (Store Orders)
    match /orders/{orderId} {
      // Clientes pueden registrar pedidos desde el carrito con campos obligatorios
      allow create: if request.resource.data.customer.name is string
                    && request.resource.data.customer.name.size() >= 2
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.total is number;

      // Lectura individual por ID: permite al cliente consultar su comprobante
      allow get: if true;

      // Listado masivo y administración: exclusivo para administradores
      allow list, update, delete: if isAdmin();
    }
  }
}
