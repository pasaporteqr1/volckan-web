rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Configuración del portal, catálogos y formularios (lectura pública, escritura solo admin autenticado)
    match /config/{configDoc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Colección de Solicitudes de Carnets Individuales
    match /carnet_submissions/{submissionId} {
      // Creación pública desde el enlace con validación de datos requeridos y longitud
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.fullName.size() >= 2
                    && request.resource.data.fullName.size() <= 120
                    && request.resource.data.idNumber is string
                    && request.resource.data.idNumber.size() >= 2
                    && request.resource.data.idNumber.size() <= 60;

      // Lectura individual por ID: permite al titular ver su comprobante y validación por QR
      allow get: if true;

      // Listado masivo de toda la colección: EXCLUSIVO PARA ADMINISTRADORES AUTENTICADOS
      // (Protege la privacidad de todos los titulares ante scrapping o extracción masiva)
      allow list: if request.auth != null;

      // Actualización de estado y borrado: solo administradores
      allow update, delete: if request.auth != null;
    }

    // 3. Documento legado de respaldo para sincronización
    match /data/carnet_submissions {
      allow read, write: if request.auth != null;
    }

    // 4. Catálogo de productos y colecciones de la tienda
    match /mercado_products/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /mercado_collections/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /mercado_categories/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
