rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Fotografías de carnets oficiales
    match /carnet_photos/{allPaths=**} {
      // Subida pública de fotografías desde el formulario (máximo 5 MB, tipo imagen)
      allow create: if request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      
      // Lectura pública de la fotografía para renderizado en credenciales y carnets digitales
      allow read: if true;
      
      // Eliminación o reemplazo restringido a administradores
      allow update, delete: if request.auth != null;
    }

    // Assets del portal y tienda (logos, portadas, banners)
    match /mercado-assets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Regla general por defecto
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
