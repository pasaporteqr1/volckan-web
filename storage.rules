rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAdmin() {
      return request.auth != null;
    }

    // Fotografías de carnets y credenciales oficiales
    match /carnet_photos/{allPaths=**} {
      // Subida de fotografías desde el formulario (máximo 5 MB, tipo imagen)
      allow create: if request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      
      // Lectura pública de la fotografía para renderizado en credenciales y carnets digitales
      allow read: if true;
      
      // Eliminación o reemplazo restringido a administradores
      allow update, delete: if isAdmin();
    }

    // Assets del portal y tienda (logos, portadas de cuentos/soluciones, banners)
    match /mercado-assets/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Regla restrictiva por defecto: nada fuera de las rutas declaradas puede escribirse ni leerse
    match /{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
